<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>

    <!--
        Let environment variables override any entry below: the variable is the key in
        upper case with dots as underscores (database.url -> DATABASE_URL,
        filter.minPeriod -> FILTER_MIN_PERIOD). A hosted deployment sets its PostgreSQL
        connection this way; without those variables the embedded H2 file below is used.
    -->
    <entry key='config.useEnvironmentVariables'>true</entry>

    <!-- Database Configuration (default: embedded H2 file) -->
    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database;DB_CLOSE_DELAY=-1;MODE=MYSQL</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password'></entry>

    <!-- SinoTrack Protocol Listener -->
    <entry key='h02.port'>5013</entry>
    <entry key='protocols.enable'>h02,osmand</entry>

    <!-- Cross-origin (CORS) header for API calls from other sites -->
    <entry key='web.origin'>*</entry>

    <!-- ── Filter Configuration (FIXED) ────────────────────────── -->
    <entry key='filter.enable'>true</entry>
    <entry key='filter.invalid'>true</entry>
    <entry key='filter.zero'>true</entry>
    <entry key='filter.duplicate'>true</entry>
    <entry key='filter.static'>true</entry>

    <!-- Enforce filtering even if packet has heartbeat/battery attributes -->
    <entry key='filter.skipAttributes'>false</entry>

    <!-- Minimum interval in seconds between 2 saved fixes from the same device -->
    <!-- (Replaces the non-existent filter.time) -->
    <entry key='filter.minPeriod'>10</entry>

    <!-- Discard points closer than 20 meters (70 meters is often too large and skips turns) -->
    <entry key='filter.distance'>20</entry>

    <!--
        Keep one position at least every 30 minutes even when every filter above would drop
        it, so a parked vehicle still shows a recent "last seen" and current location.
        (The static filter alone would drop every position of a parked vehicle forever.)
    -->
    <entry key='filter.skipLimit'>1800</entry>

</properties>
